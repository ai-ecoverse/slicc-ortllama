{
  "name": "@ai-ecoverse/slicc-ortllama",
  "version": "0.0.0",
  "description": "Local ONNX model server with OpenAI-style APIs, in slicc-kernel and on Node hosts",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-ortllama.git"
  },
  "engines": {
    "node": ">=24"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-ortllama",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.js",
    "./pi-audio": "./src/pi-audio.js",
    "./ort/node": "./src/ort/node.js",
    "./ort/web": "./src/ort/web.js"
  },
  "files": [
    "src",
    "fixtures"
  ],
  "scripts": {
    "prepare": "slicc-install-hooks",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "test": "node --test --test-timeout=600000 test/integration/*.test.mjs",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release",
    "test:unit": "mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'"
  },
  "devDependencies": {
    "@ai-ecoverse/jev-omni.js": "0.2.0",
    "@ai-ecoverse/kev.js": "1.2.0",
    "@ai-ecoverse/pi-audio": "1.27.3",
    "@ai-ecoverse/slicc-shared-web": "2.12.0",
    "@audio/decode-aac": "1.6.0",
    "@audio/encode-aac": "1.2.1",
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "1.3.0",
    "@mediabunny/aac-encoder": "1.62.0",
    "@wllama/wllama": "3.8.1",
    "espeak-ng": "1.0.2",
    "lefthook": "2.2.2",
    "mediabunny": "1.62.0",
    "monocart-coverage-reports": "2.13.2",
    "onnxruntime-node": "1.30.0",
    "phonemize": "2.0.1",
    "phonemizer": "1.2.1",
    "semantic-release": "25.0.9",
    "webgpu": "0.6.2"
  },
  "dependencies": {
    "@huggingface/jinja": "0.5.10",
    "@huggingface/tokenizers": "0.2.0",
    "@jsquash/webp": "1.5.0",
    "fast-png": "8.0.0",
    "fflate": "0.8.3",
    "jpeg-js": "0.4.4",
    "libopus-wasm": "0.4.1",
    "onnxruntime-web": "1.30.0",
    "ws": "8.22.0"
  },
  "bin": {
    "ortllama": "src/bin.js"
  },
  "imports": {
    "#ort": {
      "slicc": "./src/ort/web.js",
      "default": "./src/ort/node.js"
    }
  },
  "peerDependencies": {
    "@ai-ecoverse/jev-omni.js": "0.2.0",
    "@ai-ecoverse/kev.js": "1.2.0",
    "@audio/decode-aac": "1.6.0",
    "@audio/encode-aac": "1.2.1",
    "@mediabunny/aac-encoder": "1.62.0",
    "@wllama/wllama": "3.8.1",
    "espeak-ng": "1.0.2",
    "mediabunny": "1.62.0",
    "onnxruntime-node": "1.30.0",
    "phonemize": "2.0.1",
    "phonemizer": "1.2.1",
    "webgpu": "0.6.2"
  },
  "peerDependenciesMeta": {
    "@ai-ecoverse/jev-omni.js": {
      "optional": true
    },
    "@ai-ecoverse/kev.js": {
      "optional": true
    },
    "@audio/decode-aac": {
      "optional": true
    },
    "@audio/encode-aac": {
      "optional": true
    },
    "@mediabunny/aac-encoder": {
      "optional": true
    },
    "@wllama/wllama": {
      "optional": true
    },
    "espeak-ng": {
      "optional": true
    },
    "mediabunny": {
      "optional": true
    },
    "onnxruntime-node": {
      "optional": true
    },
    "phonemize": {
      "optional": true
    },
    "phonemizer": {
      "optional": true
    },
    "webgpu": {
      "optional": true
    }
  }
}
